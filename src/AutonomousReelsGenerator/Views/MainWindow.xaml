<Window x:Class="AutonomousReelsGenerator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Autonomous Reels Generator" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#16213e" Padding="20">
            <StackPanel>
                <TextBlock Text="🎬 Autonomous Reels Generator" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="#e94560"/>
                <TextBlock Text="AI-powered video creation for social media" 
                          FontSize="14" 
                          Foreground="#a0a0a0"
                          Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="MainContent" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Media Selection -->
                <Border Grid.Row="0" Background="#16213e" Margin="20" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="📁 Select Media" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#ffffff"
                                  Margin="0,0,0,15"/>
                        
                        <Button x:Name="BtnSelectMedia" 
                                Content="➕ Add Images &amp; Videos" 
                                Click="BtnSelectMedia_Click"
                                Background="#0f3460"
                                Foreground="#ffffff"
                                BorderThickness="0"
                                Padding="15,10"
                                CornerRadius="5"
                                Cursor="Hand"
                                Margin="0,0,0,15"/>
                        
                        <ItemsControl x:Name="LstSelectedMedia">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0f3460" 
                                           CornerRadius="5" 
                                           Padding="10" 
                                           Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" 
                                                      Text="{Binding}" 
                                                      Foreground="#ffffff"
                                                      TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" 
                                                   Content="✕" 
                                                   Click="BtnRemoveMedia_Click"
                                                   Background="#e94560"
                                                   Foreground="#ffffff"
                                                   BorderThickness="0"
                                                   Width="25"
                                                   Height="25"
                                                   CornerRadius="3"
                                                   Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Settings -->
                <Border Grid.Row="1" Background="#16213e" Margin="20" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="⚙️ Generation Settings" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#ffffff"
                                  Margin="0,0,0,15"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Left Column -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Frames per Image:" 
                                          Foreground="#a0a0a0"
                                          Margin="0,0,0,5"/>
                                <Slider x:Name="SldFramesPerImage" 
                                       Minimum="5" Maximum="60" 
                                       Value="15"
                                       TickFrequency="5"
                                       IsSnapToTickEnabled="True"
                                       Background="#0f3460"/>
                                <TextBlock x:Name="TxtFramesPerImage" 
                                          Text="15 frames" 
                                          Foreground="#e94560"
                                          Margin="0,5,0,15"/>
                                
                                <TextBlock Text="Frames per Video:" 
                                          Foreground="#a0a0a0"
                                          Margin="0,0,0,5"/>
                                <Slider x:Name="SldFramesPerVideo" 
                                       Minimum="10" Maximum="90" 
                                       Value="30"
                                       TickFrequency="10"
                                       IsSnapToTickEnabled="True"
                                       Background="#0f3460"/>
                                <TextBlock x:Name="TxtFramesPerVideo" 
                                          Text="30 frames" 
                                          Foreground="#e94560"
                                          Margin="0,5,0,15"/>
                            </StackPanel>
                            
                            <!-- Right Column -->
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Transition Frames:" 
                                          Foreground="#a0a0a0"
                                          Margin="0,0,0,5"/>
                                <Slider x:Name="SldTransitionFrames" 
                                       Minimum="3" Maximum="15" 
                                       Value="5"
                                       Background="#0f3460"/>
                                <TextBlock x:Name="TxtTransitionFrames" 
                                          Text="5 frames" 
                                          Foreground="#e94560"
                                          Margin="0,5,0,15"/>
                                
                                <CheckBox x:Name="ChkBackgroundMusic" 
                                         Content="🎵 Include Background Music" 
                                         IsChecked="True"
                                         Foreground="#ffffff"
                                         Margin="0,0,0,10"/>
                                
                                <TextBlock Text="Music Style:" 
                                          Foreground="#a0a0a0"
                                          Margin="0,0,0,5"/>
                                <ComboBox x:Name="CmbMusicStyle" 
                                         SelectedIndex="0"
                                         Background="#0f3460"
                                         Foreground="#ffffff">
                                    <ComboBoxItem Content="Ambient"/>
                                    <ComboBoxItem Content="Upbeat"/>
                                    <ComboBoxItem Content="Cinematic"/>
                                    <ComboBoxItem Content="Lo-fi"/>
                                    <ComboBoxItem Content="Electronic"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Progress Section (Hidden by default) -->
                <Border x:Name="ProgressSection" 
                       Grid.Row="2" 
                       Background="#16213e" 
                       Margin="20" 
                       CornerRadius="10" 
                       Padding="20"
                       Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="🚀 Generating Your Reel..." 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="#e94560"
                                  Margin="0,0,0,15"/>
                        
                        <ProgressBar x:Name="PrbGeneration" 
                                    Height="25" 
                                    Minimum="0" 
                                    Maximum="100"
                                    Value="0"
                                    Background="#0f3460"
                                    Foreground="#e94560"
                                    Margin="0,0,0,10"/>
                        
                        <TextBlock x:Name="TxtProgressStatus" 
                                  Text="Initializing..." 
                                  Foreground="#a0a0a0"
                                  TextWrapping="Wrap"/>
                        
                        <Button x:Name="BtnCancel" 
                               Content="❌ Cancel" 
                               Click="BtnCancel_Click"
                               Background="#e94560"
                               Foreground="#ffffff"
                               BorderThickness="0"
                               Padding="15,10"
                               CornerRadius="5"
                               Cursor="Hand"
                               Margin="0,15,0,0"
                               HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Extraction UI (Hidden by default) -->
        <Grid x:Name="ExtractionUI" Grid.Row="1" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📦 First-Time Setup" 
                          FontSize="24" 
                          FontWeight="Bold" 
                          Foreground="#e94560"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,20"/>
                
                <TextBlock Text="Extracting AI models and FFmpeg to workspace..." 
                          Foreground="#a0a0a0"
                          FontSize="14"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,30"/>
                
                <ProgressBar x:Name="PrbExtraction" 
                            Width="400" 
                            Height="30" 
                            Minimum="0" 
                            Maximum="100"
                            Value="0"
                            Background="#0f3460"
                            Foreground="#e94560"
                            Margin="0,0,0,20"/>
                
                <TextBlock x:Name="TxtExtractionStatus" 
                          Text="Preparing extraction..." 
                          Foreground="#ffffff"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Footer / Action Bar -->
        <Border Grid.Row="2" Background="#16213e" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="TxtStatus" 
                          Grid.Column="0"
                          Text="Ready to create your reel!" 
                          VerticalAlignment="Center"
                          Foreground="#a0a0a0"/>
                
                <Button x:Name="BtnGenerate" 
                       Grid.Column="1"
                       Content="✨ Generate Reel" 
                       Click="BtnGenerate_Click"
                       Background="#e94560"
                       Foreground="#ffffff"
                       BorderThickness="0"
                       Padding="30,15"
                       FontSize="16"
                       FontWeight="Bold"
                       CornerRadius="5"
                       Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
